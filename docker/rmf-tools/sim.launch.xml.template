<?xml version="1.0"?>
<!-- RMF simulation for the __MAP__ building. Generated by generate_world.sh.

     Server only (-s): the simulation runs headless, and the Gazebo GUI attaches
     to it separately as a viewer (see entrypoint.sh), so the viewer can come and
     go without disturbing the sim.

     The nodes below are what make this an RMF simulation rather than just
     Gazebo: a traffic schedule to reserve routes, blockade + mutex groups to
     stop robots deadlocking each other, a task dispatcher to award jobs, and
     the building map server that publishes the map itself — which is also what
     resolves a position into a level, and what door requests are issued
     against. -->
<launch>
  <arg name="gz_args" default="-s -r /worlds/__MAP__/__MAP__.world"/>

  <set_env name="GZ_SIM_RESOURCE_PATH"
           value="/maps/__MAP__:/worlds/__MAP__:/worlds/__MAP__/models"/>

  <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
    <arg name="gz_args" value="$(var gz_args)"/>
  </include>

  <!-- sim time into ROS, so everything below shares the simulation's clock -->
  <node pkg="ros_gz_bridge" exec="parameter_bridge"
        args="/clock@rosgraph_msgs/msg/Clock[gz.msgs.Clock"/>

  <node pkg="rmf_traffic_ros2" exec="rmf_traffic_schedule"/>
  <node pkg="rmf_traffic_ros2" exec="rmf_traffic_blockade"/>
  <node pkg="rmf_fleet_adapter" exec="mutex_group_supervisor"/>
  <node pkg="rmf_task_ros2" exec="rmf_task_dispatcher"/>

  <node pkg="rmf_building_map_tools" exec="building_map_server"
        args="/maps/__MAP__/__MAP__.building.yaml"/>
</launch>
