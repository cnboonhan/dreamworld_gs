# One port in, every surface behind it. Routes grow as services return.
# Two ways a service lives behind its prefix: stripped (the upstream never
# knows — noVNC) or mounted (the upstream serves AT the prefix — NiceGUI).
#
# Upstreams are VARIABLES on purpose: nginx then defers DNS to request
# time through Docker's embedded resolver, so a service absent from this
# launch (the minimal profile) 502s its own path instead of killing nginx
# at boot, and a rebuilt container's new address is found without
# restarting this proxy.
server {
    listen 80;
    # relative redirects: nginx's absolute ones are built from Host
    # WITHOUT the port, which sent the browser to :80 and nothing
    absolute_redirect off;
    client_max_body_size 200m;        # panorama uploads pass through here
    resolver 127.0.0.11 valid=5s ipv6=off;

    # the traffic editor's screen: noVNC static files and the websocket both
    # live on the same upstream port, and the client uses relative paths, so
    # a prefix-stripping proxy is all it takes
    location ~ ^/sim_editor(/.*)$ {
        set $sim_editor sim_editor;
        proxy_pass http://$sim_editor:8080$1$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;    # a VNC session is one long request
    }

    # path= is load-bearing: the noVNC client builds its websocket URL
    # from that setting ROOT-relative, so without it the browser asks for
    # /websockify — outside the prefix — and reports "failed to connect".
    location = /sim_editor {
        return 302 "/sim_editor/vnc.html?autoconnect=true&resize=remote&path=sim_editor/websockify";
    }

    # the project files, served straight off the mounted assets — the
    # editor is not needed on the read path, which is what lets the
    # minimal launch drop it. Metered: a full-rate 30MB burst starves an
    # SSH tunnel's keepalives until VS Code declares the connection dead.
    location /dreamworld_editor/files/ {
        alias /projects/${DW_PROJECT}/dreamworld/;
        limit_rate 8m;
    }

    # the graph: the LIVE editor answers when it is running; without one
    # (minimal), the file the editor baked on its last change stands in
    location = /dreamworld_editor/graph {
        set $editor dreamworld_editor;
        proxy_pass http://$editor:8080;
        proxy_set_header Host $host;
        proxy_intercept_errors on;
        error_page 502 504 = @baked_graph;
    }

    location @baked_graph {
        root /projects/${DW_PROJECT}/dreamworld;
        try_files /.graph.json =404;
    }

    # the dreamworld editor mounts ITSELF at /dreamworld_editor (NiceGUI's
    # mount_path), so the URI passes through unstripped — page, assets and
    # the socket.io websocket all agree on where they live
    location /dreamworld_editor/ {
        set $editor dreamworld_editor;
        proxy_pass http://$editor:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
    }

    location = /dreamworld_editor {
        return 302 /dreamworld_editor/;
    }

    # the simulation's screen: the same noVNC shape as the traffic editor
    location ~ ^/rmfsim(/.*)$ {
        set $rmfsim rmfsim;
        proxy_pass http://$rmfsim:8080$1$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
    }

    location = /rmfsim {
        return 302 "/rmfsim/vnc.html?autoconnect=true&resize=remote&path=rmfsim/websockify";
    }

    # the harness: dashboard, tools and the mission agent — a flask app
    # whose page fetches relatively, so the prefix strips
    location ~ ^/harness(/.*)$ {
        set $harness harness;
        proxy_pass http://$harness:8086$1$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;    # /events is a long stream
        proxy_buffering off;
    }

    location = /harness {
        return 302 /harness/;
    }

    # the live layer: LingBot's MJPEG rollout and its seed endpoint.
    # proxy_buffering off — a multipart stream that nginx buffers arrives
    # in lumps, which is exactly what a live view must not do.
    location ~ ^/lingbot(/.*)$ {
        set $lingbot lingbot;
        proxy_pass http://$lingbot:8000$1$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }

    # the state holder: the seam between the walk and the building
    location ~ ^/dreamworld_core(/.*)$ {
        set $core dreamworld_core;
        proxy_pass http://$core:8000$1$is_args$args;
        proxy_set_header Host $host;
    }

    # the viewer's state, at the viewer's ADDRESS: the state itself lives
    # in the browser tab, which can only push, so dreamworld_core holds
    # it — this route just puts the door where a harness author will look
    location = /dreamworld_viewer/state {
        set $core dreamworld_core;
        proxy_pass http://$core:8000/viewer/state;
        proxy_set_header Host $host;
    }

    # the walkthrough viewer: static files with relative paths, so the
    # prefix strips like noVNC's
    location ~ ^/dreamworld_viewer(/.*)$ {
        set $viewer dreamworld_viewer;
        proxy_pass http://$viewer:80$1$is_args$args;
        proxy_set_header Host $host;
    }

    location = /dreamworld_viewer {
        return 302 /dreamworld_viewer/;
    }

    location = / {
        root /usr/share/nginx/html;
        try_files /index.html =404;
    }
}
