# Every DW_ variable the stack reads, with its default. Copy what you need
# into .env (gitignored — safe for keys) and restart the service that reads
# it. `just` regenerates the three variables at the top on every run and
# carries everything else through untouched, so additions here survive.
#
#   cp .env.example .env      # then uncomment and edit
#
# A real environment variable wins over .env, so a one-off override is
#   DW_PROJECT=htx just world

# ---- owned by `just _env` — written automatically, shown for completeness --
#DW_UID=1000                  # run containers as this uid (outputs stay yours)
#DW_GID=1000
#DW_PROJECT=multilevel_office # the active project under assets/projects/

# ---- the building --------------------------------------------------------
#DW_MAP=multilevel_office     # map name under <project>/maps and /worlds —
                              # matches the project name unless yours differs
#DW_LEVEL=L11                 # level the stack opens on
#DW_START=lift_lobby          # waypoint the robot and model start at

# ---- GPUs -----------------------------------------------------------------
#DW_VLM_GPU=0                 # card for the VLM (trajectory planner + agent)
#DW_GPU_IDS=1,2,3,4           # cards for world generation; HY-World shards
                              # across all of them, and just derives its rank
                              # count from this list
#DW_EDIT_GPU=5                # card for the panorama editor's model (~45 GB)

# ---- the mission agent's model --------------------------------------------
# Any OpenAI-compatible endpoint. Defaults to the vlm service this stack runs;
# point it elsewhere and no rebuild is needed — restart interactive.
#DW_VLM_URL=http://localhost:8000/v1
#DW_VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
#DW_VLM_KEY=x                 # sent as the Bearer key; keep real keys in .env

# ---- pacing (shared by the splat camera and the robot) ---------------------
#DW_DRIVE_SPEED=2.0           # m/s along a corridor, both rollouts
#DW_TURN_RATE=1.25            # rad/s in place, both rollouts
#DW_VIEWER_SPEED=             # ?speed= added to printed viewer URLs — a
                              # hand-driven walk's pace; empty means the
                              # viewer default (2.0, matching the robot)

# ---- ports ------------------------------------------------------------------
#DW_PREFECT_PORT=4200         # jobs + logs
#DW_VIEWER_PORT=8081          # splat viewer
#DW_PANO_PORT=8082            # 360 viewer for input panoramas
#DW_RMF_PORT=8083             # the building under RMF (noVNC)
#DW_EDITOR_PORT=8084          # traffic editor (noVNC)
#DW_INTERACTIVE_PORT=8086     # dashboard + tools; if changed, open the viewer
                              # from the dashboard's link — its generated
                              # &agent= carries the right port
#DW_PANOEDIT_PORT=8087        # panorama editor
#DW_QWEN_PORT=8088            # the editor's model server
#DW_GALAXEA_PORT=8090         # robot bridge (published by rmfsim)
